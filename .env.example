# Vidyaverse AI 2.0 - Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub!

# ─── PRIMARY: OpenRouter (routes to GPT-4o, Claude, Gemini, Mistral, and more)
# Get your free key at: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── YouTube Data API v3 (for live video lecture search — 100 req/day free)
# Get key at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=your_youtube_api_key_here

# ─── Web Search API (Optional — 2,500 free searches/month)
# Get key at: https://serper.dev
SEARCH_API_KEY=your_serper_api_key_here
